# TGO DevStudio Prime — local development template
# Copy to .env.local and replace every placeholder. Never commit real secrets.

# Required application configuration
MONGODB_URI=mongodb://127.0.0.1:27017/tgo_devstudio_prime
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_TEMP_2FA_SECRET=replace-with-a-different-long-random-secret
SETUP_SECRET_KEY=replace-with-a-long-random-one-time-setup-secret
SITE_URL=http://localhost:3000
ADMIN_PATH=admin

# Optional Google OAuth (Google Search Console / Analytics and sign-in flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional Gemini environment-provider import.
# The AI Workforce can also store provider keys encrypted in its provider records.
GEMINI_API_KEY=

# Optional transactional email environment fallback
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional SMS environment fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# Optional media delivery configuration (only if enabled by the application)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
